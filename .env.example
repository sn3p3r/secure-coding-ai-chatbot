# Copy this file to .env and fill in real values. Never commit .env.

# Required for SecureMentor (the game works without it - the mentor just goes offline)
ANTHROPIC_API_KEY=

# Required before deploying: a long random string used to sign session cookies
# e.g.  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: set to 0 in production (turns off the debugger and auto-reload)
FLASK_DEBUG=1

# Optional: port for `python3 app.py` (macOS AirPlay often occupies 5000)
PORT=5000
